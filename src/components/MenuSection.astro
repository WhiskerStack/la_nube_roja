---
import { getMenu, getImageUrl } from '../lib/menu';

const categories = getMenu();
---

<section id="menu" class="menu-section">
  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Nuestro Menú</span>
      <h2>Platos que cuentan historias</h2>
      <p>Recetas cubanas preparadas con amor, servidas con estilo. Descubre nuestra selección de la casa.</p>
    </div>

    {categories.map((category) => (
      <div class="menu-category" id={category.id}>
        <div class="category-head">
          <h3>{category.name}</h3>
          <span class="category-line"></span>
        </div>
        <div class="menu-grid">
          {category.items.map((item) => (
            <article class="menu-card">
              <div class="card-image">
                <img src={getImageUrl(item.image)} alt={item.name} loading="lazy" />
                {item.tag && <span class="card-tag">{item.tag}</span>}
              </div>
              <div class="card-body">
                <div class="card-title">
                  <h4>{item.name}</h4>
                </div>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .menu-section {
    background: var(--bg-cream);
    color: var(--brown);
    padding: 96px 0;
  }

  .menu-section .eyebrow {
    color: var(--accent);
  }

  .menu-section .section-head p {
    color: #6b4f43;
  }

  .menu-category {
    margin-bottom: 64px;
  }

  .menu-category:last-child {
    margin-bottom: 0;
  }

  .category-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }

  .category-head h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--brown);
    white-space: nowrap;
  }

  .category-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(62, 39, 35, 0.3), transparent);
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }

  .menu-card {
    background: #fffaf2;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(62, 39, 35, 0.08);
    box-shadow: 0 10px 30px rgba(62, 39, 35, 0.08);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .menu-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(230, 126, 34, 0.18);
  }

  .card-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .menu-card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .card-title h4 {
    font-size: 1.15rem;
    color: var(--brown);
  }

  .card-body p {
    color: #6b4f43;
    font-size: 0.92rem;
    margin: 0;
    flex: 1;
  }
</style>