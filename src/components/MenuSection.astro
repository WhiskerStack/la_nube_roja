---
import { getMenu, getImageUrl } from '../lib/menu';

const categories = getMenu();
---

<section id="menu" class="menu-section">
  <div class="menu-pattern" aria-hidden="true">
    <svg xmlns="http://www.w3.org/2000/svg" width="100%" height="100%">
      <defs>
        <pattern id="foodIcons" x="0" y="0" width="540" height="540" patternUnits="userSpaceOnUse">
          <!-- Fork & Knife -->
          <g transform="translate(20 30) rotate(-8) scale(1.6)" fill="none" stroke="#3e2723" stroke-opacity="0.1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M8 2v20M4 2v6a4 4 0 0 0 8 0V2" />
            <path d="M20 2c-2 3-3 6-3 8h6c0-2-1-5-3-8zM20 10v12" />
          </g>

          <!-- Burger -->
          <g transform="translate(210 25) rotate(14) scale(1.4)" fill="none" stroke="#e67e22" stroke-opacity="0.13" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 9a8 4 0 0 1 16 0" />
            <path d="M2 9h16" />
            <path d="M3 9v1.5a7 2 0 0 0 14 0V9" />
            <path d="M3 12a7 3 0 0 0 14 0" />
          </g>

          <!-- Wine Glass -->
          <g transform="translate(400 45) rotate(-5) scale(1.6)" fill="none" stroke="#3e2723" stroke-opacity="0.09" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 2h10l-1 6a4 4 0 0 1-8 0L5 2z" />
            <path d="M10 12v6M6 18h8" />
          </g>

          <!-- Coffee Cup -->
          <g transform="translate(80 155) rotate(6) scale(1.7)" fill="none" stroke="#e67e22" stroke-opacity="0.14" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8h11v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8z" />
            <path d="M15 10h1.5a2.5 2.5 0 0 1 0 5H15" />
            <path d="M7 4v2M10 3v3M13 4v2" />
          </g>

          <!-- Pizza Slice -->
          <g transform="translate(310 140) rotate(-14) scale(1.4)" fill="none" stroke="#3e2723" stroke-opacity="0.1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 2L2.5 17.5l7.5-2 7.5 2L10 2z" />
            <circle cx="8" cy="12" r="1.2" fill="#3e2723" fill-opacity="0.1" stroke="none" />
            <circle cx="12" cy="12" r="1.2" fill="#3e2723" fill-opacity="0.1" stroke="none" />
            <circle cx="10" cy="8" r="1.2" fill="#3e2723" fill-opacity="0.1" stroke="none" />
          </g>

          <!-- Ice Cream Cone -->
          <g transform="translate(460 195) rotate(9) scale(1.5)" fill="none" stroke="#e67e22" stroke-opacity="0.13" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5.5 7a4.5 4.5 0 0 1 9 0" />
            <path d="M5.5 7h9l-4.5 12L5.5 7z" />
            <path d="M7 11l6-1.5M8 14l4-1" />
          </g>

          <!-- Apple -->
          <g transform="translate(15 285) rotate(-7) scale(1.5)" fill="none" stroke="#3e2723" stroke-opacity="0.1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 5c-4 0-7 3-7 7 0 4 3 6 7 6s7-2 7-6c0-4-3-7-7-7z" />
            <path d="M10 5c0-2 1-3 2-3" />
            <path d="M12 3c1.2 0 2.2 1 2.2 2.2" />
          </g>

          <!-- Cupcake -->
          <g transform="translate(195 330) rotate(16) scale(1.6)" fill="none" stroke="#e67e22" stroke-opacity="0.14" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M5 10h10l-1 8H6L5 10z" />
            <path d="M5 10c0-4 2.5-6 5-6s5 2 5 6" />
            <path d="M7.5 13.5h5M7.8 16h4.4" />
          </g>

          <!-- Fish -->
          <g transform="translate(395 355) rotate(-11) scale(1.4)" fill="none" stroke="#3e2723" stroke-opacity="0.09" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 10c3-4 8-4 11 0-3 4-8 4-11 0z" />
            <path d="M13 10l4-4v8l-4-4" />
            <circle cx="6" cy="9.5" r="0.7" fill="#3e2723" fill-opacity="0.09" stroke="none" />
          </g>

          <!-- Burger 2 (variante, más pequeño) -->
          <g transform="translate(105 425) rotate(5) scale(1.4)" fill="none" stroke="#e67e22" stroke-opacity="0.12" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M2 9a8 4 0 0 1 16 0" />
            <path d="M2 9h16" />
            <path d="M3 9v1.5a7 2 0 0 0 14 0V9" />
            <path d="M3 12a7 3 0 0 0 14 0" />
          </g>

          <!-- Pizza Slice 2 -->
          <g transform="translate(300 470) rotate(-9) scale(1.5)" fill="none" stroke="#3e2723" stroke-opacity="0.1" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M10 2L2.5 17.5l7.5-2 7.5 2L10 2z" />
            <circle cx="8" cy="12" r="1.2" fill="#3e2723" fill-opacity="0.1" stroke="none" />
            <circle cx="12" cy="12" r="1.2" fill="#3e2723" fill-opacity="0.1" stroke="none" />
            <circle cx="10" cy="8" r="1.2" fill="#3e2723" fill-opacity="0.1" stroke="none" />
          </g>

          <!-- Coffee Cup 2 -->
          <g transform="translate(490 465) rotate(12) scale(1.3)" fill="none" stroke="#e67e22" stroke-opacity="0.11" stroke-width="1.8" stroke-linecap="round" stroke-linejoin="round">
            <path d="M4 8h11v6a5 5 0 0 1-5 5H9a5 5 0 0 1-5-5V8z" />
            <path d="M15 10h1.5a2.5 2.5 0 0 1 0 5H15" />
            <path d="M7 4v2M10 3v3M13 4v2" />
          </g>
        </pattern>
      </defs>
      <rect width="100%" height="100%" fill="url(#foodIcons)" />
    </svg>
  </div>

  <div class="container">
    <div class="section-head">
      <span class="eyebrow">Nuestro Menú</span>
      <h2>Platos que cuentan historias</h2>
      <p>Recetas cubanas preparadas con amor, servidas con estilo. Descubre nuestra selección de la casa.</p>
    </div>

    {categories.map((category) => (
      <div class="menu-category" id={category.id}>
        <div class="category-head">
          <h3>{category.name}</h3>
          <span class="category-line"></span>
        </div>
        <div class="menu-grid">
          {category.items.map((item) => (
            <article class="menu-card">
              <div class="card-image">
                <img src={getImageUrl(item.image)} alt={item.name} loading="lazy" />
                {item.tag && <span class="card-tag">{item.tag}</span>}
              </div>
              <div class="card-body">
                <div class="card-title">
                  <h4>{item.name}</h4>
                </div>
                <p>{item.description}</p>
              </div>
            </article>
          ))}
        </div>
      </div>
    ))}
  </div>
</section>

<style>
  .menu-section {
    position: relative;
    background: var(--bg-cream);
    color: var(--brown);
    padding: 96px 0;
    overflow: hidden;
  }

  .menu-pattern {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
  }

  .menu-pattern svg {
    width: 100%;
    height: 100%;
    display: block;
  }

  .menu-section > .container {
    position: relative;
    z-index: 1;
  }

  .menu-section .eyebrow {
    color: var(--accent);
  }

  .menu-section .section-head p {
    color: #6b4f43;
  }

  .menu-category {
    margin-bottom: 64px;
  }

  .menu-category:last-child {
    margin-bottom: 0;
  }

  .category-head {
    display: flex;
    align-items: center;
    gap: 20px;
    margin-bottom: 28px;
  }

  .category-head h3 {
    font-size: clamp(1.5rem, 3vw, 2rem);
    color: var(--brown);
    white-space: nowrap;
  }

  .category-line {
    flex: 1;
    height: 1px;
    background: linear-gradient(90deg, rgba(62, 39, 35, 0.3), transparent);
  }

  .menu-grid {
    display: grid;
    grid-template-columns: repeat(auto-fill, minmax(260px, 1fr));
    gap: 24px;
  }

  .menu-card {
    background: #fffaf2;
    border-radius: var(--radius);
    overflow: hidden;
    border: 1px solid rgba(62, 39, 35, 0.08);
    box-shadow: 0 10px 30px rgba(62, 39, 35, 0.08);
    display: flex;
    flex-direction: column;
    transition: transform 0.25s ease, box-shadow 0.25s ease;
  }

  .menu-card:hover {
    transform: translateY(-6px);
    box-shadow: 0 18px 40px rgba(230, 126, 34, 0.18);
  }

  .card-image {
    position: relative;
    aspect-ratio: 4 / 3;
    overflow: hidden;
  }

  .card-image img {
    width: 100%;
    height: 100%;
    object-fit: cover;
    transition: transform 0.5s ease;
  }

  .menu-card:hover .card-image img {
    transform: scale(1.06);
  }

  .card-tag {
    position: absolute;
    top: 12px;
    left: 12px;
    background: var(--accent);
    color: #fff;
    font-size: 0.7rem;
    font-weight: 600;
    text-transform: uppercase;
    letter-spacing: 0.05em;
    padding: 5px 10px;
    border-radius: 999px;
  }

  .card-body {
    padding: 20px;
    display: flex;
    flex-direction: column;
    gap: 10px;
    flex: 1;
  }

  .card-title {
    display: flex;
    justify-content: space-between;
    align-items: baseline;
    gap: 12px;
  }

  .card-title h4 {
    font-size: 1.15rem;
    color: var(--brown);
  }

  .card-body p {
    color: #6b4f43;
    font-size: 0.92rem;
    margin: 0;
    flex: 1;
  }
</style>