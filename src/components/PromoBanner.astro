---
import { getImageUrl } from '../lib/menu';
---

<section class="promo" id="reservar">
  <div class="container promo-inner">
    <div class="promo-copy">
      <span class="promo-eyebrow">Oferta de la semana</span>
      <h2>20% de descuento en tu primer pedido</h2>
      <p>Usa el código <strong>NUBEROJA20</strong> al reservar o pedir a domicilio y vive la experiencia cubana.</p>
      <div class="promo-actions">
        <a href="#menu" class="btn btn-primary">Pedir Ahora</a>
        <a href="#contacto" class="btn btn-outline">Reservar Mesa</a>
      </div>
    </div>
    <div class="promo-visual">
      <img src={getImageUrl('mohito.jpg')} alt="Mojito cubano" loading="lazy" />
    </div>
  </div>
</section>

<style>
  .promo {
    background: linear-gradient(135deg, var(--accent), var(--accent-2));
    color: #fff;
    padding: 72px 0;
  }

  .promo-inner {
    display: grid;
    grid-template-columns: 1.2fr 1fr;
    gap: 48px;
    align-items: center;
  }

  .promo-eyebrow {
    display: inline-block;
    font-size: 0.8rem;
    letter-spacing: 0.15em;
    text-transform: uppercase;
    font-weight: 700;
    background: rgba(255, 255, 255, 0.2);
    padding: 6px 12px;
    border-radius: 999px;
    margin-bottom: 16px;
  }

  .promo-copy h2 {
    font-size: clamp(1.8rem, 3.5vw, 2.6rem);
    margin-bottom: 16px;
    color: #fff;
  }

  .promo-copy p {
    margin: 0 0 24px;
    font-size: 1.05rem;
    color: rgba(255, 255, 255, 0.92);
  }

  .promo-copy strong {
    background: rgba(0, 0, 0, 0.2);
    padding: 2px 8px;
    border-radius: 6px;
    font-family: var(--font-serif);
  }

  .promo-actions {
    display: flex;
    gap: 16px;
    flex-wrap: wrap;
  }

  .promo-actions .btn-primary {
    background: #111;
    box-shadow: none;
  }

  .promo-actions .btn-primary:hover {
    background: #000;
    transform: translateY(-2px);
  }

  .promo-actions .btn-outline {
    border-color: rgba(255, 255, 255, 0.7);
    color: #fff;
  }

  .promo-actions .btn-outline:hover {
    background: #fff;
    color: var(--accent);
    border-color: #fff;
  }

  .promo-visual {
    display: flex;
    justify-content: center;
  }

  .promo-visual img {
    width: 100%;
    max-width: 320px;
    aspect-ratio: 1 / 1;
    object-fit: cover;
    border-radius: 24px;
    border: 6px solid rgba(255, 255, 255, 0.25);
    box-shadow: 0 30px 60px rgba(0, 0, 0, 0.3);
  }

  @media (max-width: 960px) {
    .promo-inner {
      grid-template-columns: 1fr;
      text-align: center;
    }
    .promo-actions {
      justify-content: center;
    }
    .promo-visual img {
      max-width: 260px;
    }
  }
</style>